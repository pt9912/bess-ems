<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.5.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="coverlet.msbuild" Version="10.0.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.203" />
    <PackageVersion Include="JsonSchema.Net" Version="9.2.0" />
    <PackageVersion Include="Dapper" Version="2.1.72" />
    <!-- RM-M2-MIG-02: DbUp applies the versioned SQL migrations
         emitted by d-migrate (per ADR 0001). SQL-first, embedded-
         resource loader, no C# DSL — matches the Dapper stack. -->
    <PackageVersion Include="dbup-postgresql" Version="7.0.1" />
    <PackageVersion Include="FluentModbus" Version="5.3.2" />
    <PackageVersion Include="Google.OrTools" Version="9.15.6755" />
    <!-- RM-M5-01 (ADR 0005): gRPC-Sidecar-Transport für den
         optimization-core. Grpc.Tools ist Build-Time-Source-Generator
         für proto/*.proto-Codegen; Grpc.Net.Client ist der Client-
         Channel auf HTTP/2 (UDS-Default via SocketsHttpHandler.
         ConnectCallback, mTLS für Cross-Host). Google.Protobuf ist
         die Wire-Encoder-Bibliothek. -->
    <PackageVersion Include="Google.Protobuf" Version="3.33.1" />
    <PackageVersion Include="Grpc.Net.Client" Version="2.71.0" />
    <PackageVersion Include="Grpc.Tools" Version="2.71.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.7" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.7" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.7" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.7" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.7" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.7" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.7" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.7" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.7" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.7" />
    <PackageVersion Include="MQTTnet" Version="5.1.0.1559" />
    <PackageVersion Include="Npgsql" Version="10.0.2" />
    <!-- RM-M4-04 (D-01): OPC Foundation Reference Stack. MIT-lizenziert
         (OPC Foundation MIT License 1.00, identisch mit Standard-MIT
         im Lizenz-Text — siehe https://opcfoundation.org/license/mit.html).
         Frühere Versionen liefen unter dem RCL-/Redistributables-
         Agreement; die heutige NuGet-Distribution ist unter MIT —
         kein Lizenz-Audit-Bedarf für reine Adapter-Nutzung. Wechsel
         auf Workstation.UaClient ist per IOpcUaClient-Port-Vertrag
         (D-02) trotzdem low-cost falls eine zukünftige Linie das
         verlangt. -->
    <PackageVersion Include="OPCFoundation.NetStandard.Opc.Ua" Version="1.5.378.134" />
    <!-- RM-M4-04 (D-07 Wahl a / F-16 Fallback): OPC Foundation Server-
         Library, gleicher MIT-Lizenzpfad wie das Client-Package. Wird
         ausschließlich von tests/integration/BatteryEms.OpcUa.
         IntegrationTests/ konsumiert (Embedded TestServer mit custom
         NodeManager — kein Compose-Sidecar). Production-Adapter
         referenziert das Package NICHT. -->
    <PackageVersion Include="OPCFoundation.NetStandard.Opc.Ua.Server" Version="1.5.378.134" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
    <PackageVersion Include="prometheus-net.AspNetCore" Version="8.2.1" />
    <!-- RM-M2-06 / LH-MON-003: OpenTelemetry tracing for the
         Application-grenze flows (control cycle, command dispatch,
         schedule optimisation) plus auto-instrumentation of incoming
         HTTP requests. SDK is pinned along with the matching OTLP
         exporter and AspNetCore instrumentation; the Application
         layer itself uses System.Diagnostics.ActivitySource (BCL),
         not the OTel SDK, so the Hexagon stays framework-free. -->
    <PackageVersion Include="OpenTelemetry" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.15.3" />
    <!-- 1.15.3 fixt zwei moderate Advisories aus der älteren Reihe:
         GHSA-4625-4j76-fww9 (Disk-Retry-Tempfile-Injection im OTLP-
         Exporter) und GHSA-g94r-2vxg-569j (Memory-DoS in Baggage/B3/
         Jaeger-Propagator-Parsing). Beide treffen alle Versionen
         < 1.15.3. -->
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.15.2" />
  </ItemGroup>

</Project>
