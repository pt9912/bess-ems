root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,csproj,props,targets,sln}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[Dockerfile]
indent_size = 2

# --- Code-metrics gate (RM-M1-20) -----------------------------------------
# Maintainability-/SOLID-adjacent Roslyn rules elevated to errors so they
# block the lint stage. Runs inside `make lint`; no separate tool required.
[*.cs]
dotnet_diagnostic.CA1501.severity = error
dotnet_diagnostic.CA1502.severity = error
dotnet_diagnostic.CA1505.severity = error
dotnet_diagnostic.CA1506.severity = error
dotnet_code_quality.CA1501.inheritance_excluded_symbol_names = System.Object
dotnet_code_quality.CA1502.cyclomatic_complexity_threshold = 25
dotnet_code_quality.CA1506.class_coupling_threshold = 60
dotnet_code_quality.CA1506.coupling_excluded_symbol_names = System.Object|System.Threading.CancellationToken
