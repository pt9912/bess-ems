{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Bess": {
    "SchemaDirectory": "/app/config/schema",
    "AssetConfigPath": "/app/config/examples/asset.single-bess.json",
    "SnapshotMaxAge": "00:00:10"
  },
  "Worker": {
    "CycleInterval": "00:00:01"
  },
  "ApiTokens": {
    "Tokens": []
  },
  "NativeControl": {
    "Enabled": false,
    "LibraryPath": "/app/native/libbattery_control_core.so",
    "AbortOnAbiMismatch": false
  }
}
