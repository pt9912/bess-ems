# RM-M2-MIG-02/03: d-migrate companion artefacts. The .sql files
# under Migrations/RunOnce/ are committed (they're the migration
# payload); the .report.yaml siblings are transient and contain
# generation timestamps, so they are regenerated on every
# `make schema-generate` and never tracked.
src/adapters/driven/BatteryEms.Adapters.Persistence/Migrations/**/*.report.yaml

# Claude Code harness state (per-session lock files, transcripts, etc.).
.claude/

# Release / CI artefact outputs (docs/user/releasing.md §7). Produced
# locally by `make release-assets` and in CI by the release/build
# workflows under artifacts/release(-local)/ and artifacts/ci/.
artifacts/
