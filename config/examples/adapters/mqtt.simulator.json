{
  "schema_version": "v1",
  "profile_name": "mqtt-simulator",
  "topics": [
    {
      "name": "telemetry",
      "display_name": "Battery telemetry snapshot",
      "topic": "battery/{assetId}/telemetry",
      "direction": "subscribe",
      "payload_format": "json",
      "retained": true,
      "auth_required": "none"
    },
    {
      "name": "status",
      "topic": "battery/{assetId}/status",
      "direction": "subscribe",
      "payload_format": "json",
      "retained": true,
      "auth_required": "none"
    },
    {
      "name": "fault",
      "topic": "battery/{assetId}/fault",
      "direction": "subscribe",
      "payload_format": "json",
      "retained": false,
      "auth_required": "none"
    },
    {
      "name": "command",
      "topic": "battery/{assetId}/command",
      "direction": "publish",
      "payload_format": "json",
      "retained": false,
      "auth_required": "none"
    },
    {
      "name": "command_ack",
      "topic": "battery/{assetId}/command/ack",
      "direction": "subscribe",
      "payload_format": "json",
      "retained": false,
      "auth_required": "none"
    }
  ]
}
